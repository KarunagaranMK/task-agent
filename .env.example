GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional outgoing email delivery. If omitted, HR messages remain in the local outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SIM_MODE=true
DATABASE_URL=sqlite:///./onboarding.db
DEMO_MODE=true
ITSM_OFFLINE=false
JWT_SECRET=generated-by-run-py
COOKIE_SECURE=false
LANGGRAPH_CHECKPOINT_DB=./onboarding.checkpoints.sqlite
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
